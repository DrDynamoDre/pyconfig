# pyconfig secrets template.
#
# Copy this file to ~/.pi/agent/secrets.env, fill in the values, and lock it
# down with `chmod 600 ~/.pi/agent/secrets.env`.
#
#   cp config/secrets.env.example ~/.pi/agent/secrets.env
#   chmod 600 ~/.pi/agent/secrets.env
#   $EDITOR ~/.pi/agent/secrets.env
#
# NEVER commit the filled-in secrets.env (it is gitignored).

# OpenRouter — default provider. https://openrouter.ai/keys
export OPENROUTER_API_KEY=""

# Deepgram — speech-to-text via the pi-voice-stt package.
# https://console.deepgram.com/
export DEEPGRAM_API_KEY=""

# Tavily — the web-search extension. https://app.tavily.com/
export TAVILY_API_KEY=""

# GitHub personal access token — the `github` MCP server.
# Needs at least the `repo` scope (classic PAT) to create repositories.
# https://github.com/settings/tokens
export GITHUB_PERSONAL_ACCESS_TOKEN=""

# Optional — GitHub Copilot as a model provider (`pi auth login github-copilot`
# is the OAuth alternative).
# export COPILOT_GITHUB_TOKEN=""
